{
  "comment": "Shared filter-semantics cases. Run against the Go server (internal/server/filter_cases_test.go, via /api/timeline) and the extension (extension/test/filter-cases.test.js, via applyFilters). All times are UTC and both tests evaluate dates in UTC. filter keys: start/end (YYYY-MM-DD, local day, end inclusive of the whole day), text, domain, categories, transitions, hide. want = visit ids (sorted). 'serverUnsupported' = the server API has no such filter, case runs on the client only. 'known' = documented disagreement: {server|client: ids actually returned, reason}; the test asserts the documented value so the difference cannot change silently.",
  "visits": [
    { "id": 1, "time": "2025-06-10T00:00:00Z", "url": "https://example.com/a", "title": "Alpha", "transition": "link" },
    { "id": 2, "time": "2025-06-10T23:59:59Z", "url": "https://sub.example.com/b", "title": "Beta Secret", "transition": "typed" },
    { "id": 3, "time": "2025-06-11T00:00:00Z", "url": "https://www.bet365.com/x", "title": "Secret bets", "transition": "link" },
    { "id": 4, "time": "2025-06-11T12:00:00Z", "url": "https://4tube.com:8443/a", "title": "Video", "transition": "typed" },
    { "id": 5, "time": "2025-06-12T00:00:00Z", "url": "https://other.org/c?x=1", "title": "Gamma", "transition": "reload" },
    { "id": 6, "time": "2025-06-12T10:00:00Z", "url": "https://notexample.com/d", "title": "Delta", "transition": "link" },
    { "id": 7, "time": "2025-06-12T11:00:00Z", "url": "https://ecole.example.org/100%25_done", "title": "École", "transition": "link" }
  ],
  "cases": [
    { "name": "no filter", "filter": {}, "want": [1, 2, 3, 4, 5, 6, 7] },
    { "name": "hide with no text/domain keeps flagged visits", "filter": { "hide": true }, "want": [1, 2, 3, 4, 5, 6, 7] },
    { "name": "text matches title", "filter": { "text": "alpha" }, "want": [1] },
    { "name": "text is case-insensitive", "filter": { "text": "ALPHA" }, "want": [1] },
    { "name": "text is trimmed", "filter": { "text": " alpha " }, "want": [1], "known": { "server": [], "reason": "client trims the text filter; the server LIKE-matches the untrimmed string (domain is trimmed by both)" } },
    { "name": "percent in text is literal", "filter": { "text": "100%" }, "want": [7] },
    { "name": "underscore in text is literal", "filter": { "text": "_done" }, "want": [7] },
    { "name": "non-ASCII text is case-insensitive", "filter": { "text": "éCOLE" }, "want": [7], "known": { "server": [], "reason": "SQLite LIKE folds case for ASCII only; the client uses Unicode toLowerCase" } },
    { "name": "text matches url", "filter": { "text": "other.org" }, "want": [5] },
    { "name": "text matches several", "filter": { "text": "secret" }, "want": [2, 3] },
    { "name": "hide excludes flagged text matches", "filter": { "text": "secret", "hide": true }, "want": [2] },
    { "name": "hide excludes flagged url matches", "filter": { "text": "bet365", "hide": true }, "want": [] },
    { "name": "no hide matches flagged url", "filter": { "text": "bet365" }, "want": [3] },
    { "name": "domain exact", "filter": { "domain": "other.org" }, "want": [5] },
    { "name": "domain matches subdomains but not suffix lookalikes", "filter": { "domain": "example.com" }, "want": [1, 2] },
    { "name": "domain is case-insensitive", "filter": { "domain": "EXAMPLE.COM" }, "want": [1, 2] },
    { "name": "domain is trimmed", "filter": { "domain": " example.com " }, "want": [1, 2] },
    { "name": "domain with port in url", "filter": { "domain": "4tube.com" }, "want": [4] },
    { "name": "hide excludes flagged domain matches", "filter": { "domain": "bet365.com", "hide": true }, "want": [] },
    { "name": "hide excludes flagged domain matches (port)", "filter": { "domain": "4tube.com", "hide": true }, "want": [] },
    { "name": "no hide matches flagged domain", "filter": { "domain": "bet365.com" }, "want": [3] },
    { "name": "hide keeps unflagged domain matches", "filter": { "domain": "example.com", "hide": true }, "want": [1, 2] },
    { "name": "start day is inclusive at midnight", "filter": { "start": "2025-06-11" }, "want": [3, 4, 5, 6, 7] },
    { "name": "end day covers the whole day", "filter": { "end": "2025-06-10" }, "want": [1, 2] },
    { "name": "end excludes the next midnight", "filter": { "end": "2025-06-11" }, "want": [1, 2, 3, 4] },
    { "name": "single day range", "filter": { "start": "2025-06-11", "end": "2025-06-11" }, "want": [3, 4] },
    { "name": "range excluding everything", "filter": { "start": "2025-06-13" }, "want": [] },
    { "name": "category adult", "filter": { "categories": ["adult"] }, "want": [4] },
    { "name": "category is any-of", "filter": { "categories": ["adult", "gambling"] }, "want": [3, 4] },
    { "name": "category with hide still lists flagged visits", "filter": { "categories": ["gambling"], "hide": true }, "want": [3] },
    { "name": "category with hide and text matches nothing", "filter": { "categories": ["gambling"], "hide": true, "text": "bets" }, "want": [] },
    { "name": "category and text without hide", "filter": { "categories": ["gambling"], "text": "bets" }, "want": [3] },
    { "name": "text and date", "filter": { "text": "secret", "start": "2025-06-11" }, "want": [3] },
    { "name": "domain and date", "filter": { "domain": "example.com", "end": "2025-06-09" }, "want": [] },
    { "name": "text and domain together", "filter": { "text": "beta", "domain": "example.com" }, "want": [2] },
    { "name": "text, date and hide", "filter": { "text": "secret", "end": "2025-06-11", "hide": true }, "want": [2] },
    { "name": "transition typed", "filter": { "transitions": ["typed"] }, "want": [2, 4], "serverUnsupported": true },
    { "name": "transition any-of", "filter": { "transitions": ["typed", "reload"] }, "want": [2, 4, 5], "serverUnsupported": true },
    { "name": "transition and date", "filter": { "transitions": ["link"], "start": "2025-06-11" }, "want": [3, 6, 7], "serverUnsupported": true }
  ]
}
